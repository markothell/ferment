# Copy to .env.local. Everything here is optional for local dev.

# Postgres (Neon). Unset → embedded PGlite in .data/, migrated at startup.
DATABASE_URL=

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Mail. Unset → links and invitations print to the dev server console.
RESEND_API_KEY=
EMAIL_FROM="ferment <hello@ferment.earth>"

# Comma-separated emails that may sign in without an invitation and start a community.
FERMENT_HOST_EMAILS=

# Voice recordings (Vercel Blob). Unset → saved to .data/audio locally.
BLOB_READ_WRITE_TOKEN=
# Optional: the store's public host, if it can't be read from the token.
BLOB_PUBLIC_HOST=

# Transcripts for voice answers (Deepgram). Unset → recordings play without one.
DEEPGRAM_API_KEY=

# Vercel Cron authorizes /api/cron with this (every 15 minutes, vercel.json).
CRON_SECRET=
